# Copy this to .env and fill in your values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

# SQLAlchemy async URL. Accepted forms (config.py rewrites them):
#   postgres://...
#   postgresql://...
#   postgresql+asyncpg://...
# Any "?sslmode=..." param is stripped (asyncpg uses SSL by default to managed Postgres).
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost/rollgame

SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Example for prod: CORS_ORIGINS=https://kenchislove.pages.dev,https://www.kenchislove.com
CORS_ORIGINS=http://localhost:5173
